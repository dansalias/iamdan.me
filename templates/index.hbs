<h2>Thoughts & Snippets</h2>
<ul class="articles">
  {{#each articles}}
    <li>
      <a href="/{{this.slug}}">{{this.title}}</a>
      <div class="date">{{this.date}}</div>
    </li>
  {{/each}}
</ul>
<script>
  const CODING_SINCE = 2006
  const SAASING_SINCE = 2015

  const insertSubstitions = (() => {
    const now = new Date()

    const substitutions = {
      yearsOfExperience: now.getFullYear() - CODING_SINCE,
      yearsOfSaaSExperience: now.getFullYear() - SAASING_SINCE,
    }

    for (const key in substitutions) {
      document.getElementById(key).innerHTML = substitutions[key]
    }
  })()
</script>
<script>
  const greetingElement = document.getElementById('greeting')

  if (sessionStorage.getItem('greetingHasAnimated')) {
    greetingElement.innerHTML = 'Hi! I am Dan.'
  } else {
    const GREETING_CURSOR_BLINK_RATE = 600
    const GREETING_INPUT_RATE = 40
    const GREETING_INITIAL_DELAY = 1800 // 1800
    const GREETING_PAUSE_DELAY = 2000
    const GREETING_FINAL_DELAY = 2000
    const GREETING_TEXT = 'Hi! I am Dan.'.split('').map((character, index) =>
      ({
        delay: index === 3 ? GREETING_PAUSE_DELAY : GREETING_INPUT_RATE,
        character,
      })
    )

    const animateGreeting = (() => {
      const cursorInterval = setInterval(() => {
        greetingElement.classList.toggle('show-cursor')
      }, GREETING_CURSOR_BLINK_RATE)

      const appendToGreeting = () => {
        greetingElement.innerHTML += GREETING_TEXT.shift().character

        if (GREETING_TEXT.length) {
          setTimeout(appendToGreeting, GREETING_TEXT[0].delay)
        } else {
          setTimeout(() => {
            clearInterval(cursorInterval)
            greetingElement.classList.remove('show-cursor')
          }, GREETING_FINAL_DELAY)
        }
      }

      setTimeout(() => appendToGreeting(), GREETING_INITIAL_DELAY)
    })()

    sessionStorage.setItem('greetingHasAnimated', 'true')
  }
</script>
